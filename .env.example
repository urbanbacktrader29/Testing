# Database (SQLite by default; swap for Postgres in production)
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Monthly plan price shown on the pricing page / used for Stripe ad-hoc price
PLAN_PRICE_USD=49

# Stripe (card payments)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Optional: use a pre-created recurring Price instead of an ad-hoc one
STRIPE_PRICE_ID=""

# NOWPayments (crypto payments) — https://nowpayments.io
NOWPAYMENTS_API_KEY=""
NOWPAYMENTS_IPN_SECRET=""
